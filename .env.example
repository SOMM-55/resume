# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Admin Authentication
ADMIN_USERNAME="admin"
# Default password below is "admin123" (bcrypt hash with 10 salt rounds)
# To generate a new hash: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH="$2a$10$7h1o4J5899BvF3hQ1kR4.eL88xW0Fq09s53u80x2p8GZqVw7c1eG2"
# 32+ char secret for signing admin session cookies
AUTH_SECRET="dev_secret_change_in_production_min_32_characters_random"

# Analytics privacy: secret seed used for daily-rotating visitor HMAC hashing
ANALYTICS_SALT_SECRET="daily_salt_secret_change_in_production_32_chars"

# Public site canonical base URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Contact form email forwarding (Resend or SMTP)
RESEND_API_KEY=""
CONTACT_FORWARD_EMAIL=""
